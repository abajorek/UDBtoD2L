# Mapbox — needed to render the route lines on the map.
# Get keys at https://account.mapbox.com/access-tokens/
# The public token (pk.*) is exposed to the browser; the secret token (sk.*) is server-only.
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=
MAPBOX_SECRET_TOKEN=

# Yelp Fusion — restaurants (incl. Diners-Drive-Ins-and-Dives lookups) and pet-friendly lodging.
# Get a key at https://www.yelp.com/developers/v3/manage_app
# Optional: app falls back to curated + Overpass if missing.
YELP_API_KEY=

# Google Places — parks, lodging, tourist attractions.
# Get a key at https://console.cloud.google.com/google/maps-apis
# Optional: app falls back to curated + Overpass if missing.
GOOGLE_PLACES_API_KEY=
